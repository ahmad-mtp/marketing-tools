# Copy to .env and fill in. .env is gitignored - never commit a real key.

# Apollo API key. Settings -> Integrations -> API in your Apollo account.
APOLLO_API_KEY=

# Emails and phones are both always wanted, so both default to true.
# Note: revealing personal emails consumes extra credits per match.
APOLLO_REVEAL_PERSONAL_EMAILS=true

# Phone numbers. Apollo delivers these ASYNCHRONOUSLY - the enrichment call
# returns demographics immediately and phones arrive later. We read them back
# by polling /webhook_result/{request_id}, so no public server is needed.
APOLLO_REVEAL_PHONE=true

# Mandatory whenever APOLLO_REVEAL_PHONE=true - Apollo rejects the request
# without it, even though we poll rather than wait to be called.
# If you expose this app publicly (ngrok/cloudflared), point it at the
# receiver: https://<your-tunnel>/api/apollo/webhook
APOLLO_WEBHOOK_URL=

# How long to wait for phones before giving up (Apollo: "several minutes").
APOLLO_PHONE_POLL_INTERVAL_S=10
APOLLO_PHONE_POLL_TIMEOUT_S=600

# Apollo caps bulk enrichment at 10 records per request.
APOLLO_BATCH_SIZE=10
# Pause between batches, milliseconds - keeps clear of rate limits.
APOLLO_BATCH_DELAY_MS=1000
